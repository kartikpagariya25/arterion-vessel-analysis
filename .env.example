GEMINI_API_KEY=
# Optional: enables an LLM-written multilingual report. Without it a built-in rule-based report is used.

# Accounts (see README "Accounts, history and the doctor dashboard")
# JWT_SECRET: leave empty to auto-generate one and keep it in the data volume; set it to share tokens across replicas.
JWT_SECRET=
# DOCTOR_INVITE_CODE: people registering as a doctor must enter this code. Empty = doctor sign-up disabled.
DOCTOR_INVITE_CODE=
# REQUIRE_AUTH=1 makes every endpoint (including uploads) require a signed-in user.
REQUIRE_AUTH=
# CORS_ORIGINS: comma-separated browser origins allowed to call the API, e.g. https://app.example.com. Empty = any origin.
CORS_ORIGINS=
# UPLOAD_TTL_HOURS: delete uploaded files older than this many hours (checked hourly). Empty or 0 = keep them.
UPLOAD_TTL_HOURS=
